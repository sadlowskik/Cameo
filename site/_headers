# Cloudflare Pages response headers (ignored by the nginx container; Pages-only).
# Security + privacy hardening for the static site. Tuned to this page: it uses
# inline <style>/<script>, WebGL-free canvas, self-hosted fonts, and data: URIs
# (the grain texture) — so the CSP allows exactly those.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Long-cache the immutable media; tweak names if you add hashed assets later.
/assets/*
  Cache-Control: public, max-age=604800
