#!/usr/bin/env bash
# Signed verification is always required. Mutations are delegated only when the
# installer-provisioned A/B layout contract exists.
set -euo pipefail
verifier=/usr/local/lib/cameo/update-verify
host=/usr/local/lib/cameo/update-host
layout=/etc/cameo/update-layout.json
if [ "$(id -u)" -ne 0 ]; then
  host="${CAMEO_UPDATE_TEST_HOST:-$host}"
  layout="${CAMEO_UPDATE_TEST_LAYOUT:-$layout}"
fi
command="${1:-status}"; [ "$#" -eq 0 ] || shift
case "$command" in
  status)
    if [ -f "$layout" ]; then exec "$host" status; fi
    echo "legacy single-root installation: transactional apply unavailable" ;;
  verify|preflight|apply)
    [ "$#" -eq 1 ] || { echo "usage: cameo-update $command <bundle-directory>" >&2; exit 2; }
    bundle="$1"; key=/etc/cameo/update-root.pem
    # Unprivileged test execution may supply fixture paths. Root always uses the
    # installed trust anchor and verifier.
    if [ "$(id -u)" -ne 0 ]; then
      key="${CAMEO_UPDATE_TEST_KEY:-$key}"
      verifier="${CAMEO_UPDATE_TEST_VERIFIER:-$verifier}"
    fi
    [ -f "$bundle/manifest.json" ] && [ -f "$bundle/manifest.sig" ] || { echo "cameo-update: incomplete bundle" >&2; exit 1; }
    [ -r "$key" ] || { echo "cameo-update: trusted release key is not installed" >&2; exit 1; }
    [ ! -L "$bundle" ] && [ ! -L "$bundle/manifest.json" ] && [ ! -L "$bundle/manifest.sig" ] && [ ! -L "$key" ] || { echo "cameo-update: linked trust or signature input refused" >&2; exit 1; }
    staged="$(mktemp -d)"; trap 'rm -rf -- "$staged"' EXIT
    chmod 0700 "$staged"
    cp --no-dereference "$bundle/manifest.json" "$staged/manifest.json"
    cp --no-dereference "$bundle/manifest.sig" "$staged/manifest.sig"
    chmod 0400 "$staged/manifest.json" "$staged/manifest.sig"
    openssl pkeyutl -verify -pubin -inkey "$key" -rawin -in "$staged/manifest.json" -sigfile "$staged/manifest.sig" >/dev/null
    "$verifier" verify "$bundle" / "$staged/manifest.json"
    [ "$command" = verify ] || "$verifier" preflight "$bundle" / "$staged/manifest.json"
    if [ "$command" = apply ]; then
      [ -f "$layout" ] && [ -x "$host" ] \
        || { echo "cameo-update: installed A/B layout is unavailable" >&2; exit 1; }
      "$host" apply "$bundle" "$staged/manifest.json"
      echo "cameo-update: signed offline bundle apply staged; reboot required"
      exit 0
    fi
    echo "cameo-update: signed offline bundle $command passed" ;;
  commit|auto-commit|rollback|recover)
    [ "$#" -eq 0 ] || { echo "usage: cameo-update $command" >&2; exit 2; }
    [ -f "$layout" ] && [ -x "$host" ] \
      || { echo "cameo-update: installed A/B layout is unavailable" >&2; exit 1; }
    exec "$host" "$command" ;;
  *) echo "usage: cameo-update verify|preflight|apply <bundle-directory> | status|commit|rollback|recover" >&2; exit 2 ;;
esac
