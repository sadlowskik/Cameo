#!/usr/bin/env bash
# cameo-install — install Cameo from the live medium onto a disk. OFFLINE.
#
# This turns Cameo from a live USB into a real, persistent OS. It does NOT
# download anything: the live image already carries the whole system (kernel,
# Mesa/Vulkan, llama.cpp, ggml, cameo/cameod — and, on the universal edition,
# ROCm), so the installer COPIES that image onto the target disk, installs a
# bootloader, creates your admin account, and enables the cameod console. No
# network is required to install. (Network is only needed later, at runtime, to
# pull models and to discover other Cameo nodes on your LAN — never to install.)
#
# After it finishes you reboot into an installed system and never touch the USB
# again. Accounts, keys, models and config then persist like any normal machine.
#
# The GPU tier decides nothing here: whichever edition you flashed is what lands
# on disk — the universal image ships ROCm (and uses it only on training-capable
# cards), the lite image is Vulkan-only. Pick the edition when you flash, not now.
#
# SAFETY. This erases a whole disk, so it is built to be hard to misfire:
#   * It DEFAULTS TO A DRY RUN — it prints the exact plan and changes nothing.
#     Add --commit to actually install.
#   * --commit still requires you to type the target disk's name to confirm.
#   * It refuses to install onto the device you booted from.
# Run the dry run first, read it, then re-run with --commit.
#
#   cameo-install                      # dry run: show the plan, touch nothing
#   cameo-install --disk /dev/sda      # dry run against a specific disk
#   cameo-install --commit --disk /dev/sda   # do it (after typed confirmation)
set -euo pipefail

# ---- presentation -----------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_ACCENT=$'\033[1;38;5;209m'; C_BOLD=$'\033[1m'
  C_WARN=$'\033[1;33m'; C_ERR=$'\033[1;31m'; C_OFF=$'\033[0m'
else
  C_ACCENT=""; C_BOLD=""; C_WARN=""; C_ERR=""; C_OFF=""
fi
say()  { printf '%s%s%s\n' "$C_ACCENT" "$*" "$C_OFF"; }
info() { printf '  %s\n' "$*"; }
warn() { printf '%s! %s%s\n' "$C_WARN" "$*" "$C_OFF" >&2; }
die()  { printf '%sERROR:%s %s\n' "$C_ERR" "$C_OFF" "$*" >&2; exit 1; }

# ---- arguments --------------------------------------------------------------
COMMIT=0
TARGET=""
HOSTNAME_IN=""
USERNAME_IN=""
TIMEZONE_IN=""
while [ $# -gt 0 ]; do
  case "$1" in
    --commit)   COMMIT=1 ;;
    --disk)     TARGET="${2:-}"; shift ;;
    --hostname) HOSTNAME_IN="${2:-}"; shift ;;
    --user)     USERNAME_IN="${2:-}"; shift ;;
    --timezone) TIMEZONE_IN="${2:-}"; shift ;;
    -h|--help)
      grep '^#' "$0" | sed 's/^# \{0,1\}//' | sed '/^!/d'
      exit 0 ;;
    *) die "unknown argument: $1 (see --help)" ;;
  esac
  shift
done

# ---- preflight --------------------------------------------------------------
[ "$(id -u)" -eq 0 ] || die "run as root."
[ "$(uname -m)" = "x86_64" ] || die "this build targets x86_64."

for tool in sgdisk mkfs.ext4 genfstab arch-chroot lsblk findmnt; do
  command -v "$tool" >/dev/null 2>&1 \
    || die "missing '$tool'. The live image must ship arch-install-scripts and gptfdisk."
done
# The copy needs one of these; unsquashfs is preferred (pristine image), rsync is
# the fallback. Both are shipped in the ISO, but check so a hand-rolled medium
# fails loudly here rather than halfway through a wiped disk.
if command -v unsquashfs >/dev/null 2>&1; then
  COPY_METHOD="unsquashfs"
elif command -v rsync >/dev/null 2>&1; then
  COPY_METHOD="rsync"
else
  die "need 'unsquashfs' (squashfs-tools) or 'rsync' to copy the system; neither is present."
fi

# Firmware mode decides the partition layout and how GRUB is installed.
if [ -d /sys/firmware/efi ]; then
  FIRMWARE="uefi"
  command -v mkfs.fat >/dev/null 2>&1 || die "missing 'mkfs.fat' (dosfstools) for the EFI partition."
else
  FIRMWARE="bios"
fi

# The device the live system booted from — never a valid install target.
live_disk() {
  local src parent
  src="$(findmnt -n -o SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
  [ -n "$src" ] || src="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
  [ -n "$src" ] || return 0
  parent="$(lsblk -no PKNAME "$src" 2>/dev/null | head -1 || true)"
  [ -n "$parent" ] && printf '/dev/%s\n' "$parent"
}
LIVE_DISK="$(live_disk || true)"

# Locate the pristine live root: the squashfs on the boot medium (preferred) and
# the kernel that came with it (a safety net in case the airootfs was pruned of
# /boot/vmlinuz-linux to save image space).
SFS_SRC="$(find /run/archiso/bootmnt -type f -name 'airootfs.sfs' 2>/dev/null | head -1 || true)"
KERNEL_SRC="$(find /run/archiso/bootmnt -type f -name 'vmlinuz-linux' 2>/dev/null | head -1 || true)"
if [ "$COPY_METHOD" = "unsquashfs" ] && [ -z "$SFS_SRC" ]; then
  # No sfs to unpack (unusual boot mode) — fall back to mirroring the running root.
  command -v rsync >/dev/null 2>&1 \
    || die "no airootfs.sfs found and rsync is absent; cannot copy the system."
  COPY_METHOD="rsync"
fi

# ---- choose the disk --------------------------------------------------------
list_disks() {
  # Whole disks only, excluding the live medium, as "NAME SIZE MODEL".
  lsblk -dpno NAME,SIZE,MODEL,TYPE | awk -v live="$LIVE_DISK" \
    '$4=="disk" && $1!=live { $4=""; sub(/[ \t]+$/,""); print }'
}

if [ -z "$TARGET" ]; then
  say "Target disks"
  mapfile -t DISKS < <(list_disks | awk '{print $1}')
  [ "${#DISKS[@]}" -gt 0 ] || die "no installable disk found (only the live medium is present?)."
  list_disks | nl -w2 -s'. ' | sed 's/^/  /'
  printf '  %sPick a disk number: %s' "$C_BOLD" "$C_OFF"
  read -r pick
  if ! [[ "$pick" =~ ^[0-9]+$ ]] || [ "$pick" -lt 1 ] || [ "$pick" -gt "${#DISKS[@]}" ]; then
    die "not a listed choice."
  fi
  TARGET="${DISKS[$((pick - 1))]}"
fi

[ -b "$TARGET" ] || die "$TARGET is not a block device."
if [ -n "$LIVE_DISK" ] && [ "$TARGET" = "$LIVE_DISK" ]; then
  die "$TARGET is the device you booted from — refusing to erase it."
fi

# nvme0n1 → nvme0n1p1 ; sda → sda1
partdev() {
  case "$TARGET" in
    *[0-9]) printf '%sp%s\n' "$TARGET" "$1" ;;
    *)      printf '%s%s\n' "$TARGET" "$1" ;;
  esac
}

DISK_SIZE="$(lsblk -dno SIZE "$TARGET" 2>/dev/null | tr -d ' ')"
DISK_MODEL="$(lsblk -dno MODEL "$TARGET" 2>/dev/null | sed 's/[ \t]*$//')"

# ---- gather settings --------------------------------------------------------
detect_timezone() {
  local tz
  tz="$(timedatectl show -p Timezone --value 2>/dev/null || true)"
  [ -n "$tz" ] && [ "$tz" != "n/a" ] && { printf '%s\n' "$tz"; return; }
  if [ -L /etc/localtime ]; then
    readlink /etc/localtime | sed 's|.*/zoneinfo/||'
  fi
}

HOSTNAME_VAL="${HOSTNAME_IN:-cameo}"
USERNAME_VAL="${USERNAME_IN:-}"
TIMEZONE_VAL="${TIMEZONE_IN:-}"
[ -n "$TIMEZONE_VAL" ] || TIMEZONE_VAL="$(detect_timezone)"
[ -n "$TIMEZONE_VAL" ] || TIMEZONE_VAL="UTC"

if [ "$COMMIT" -eq 1 ]; then
  if [ -z "$HOSTNAME_IN" ]; then
    printf '  Hostname [%s]: ' "$HOSTNAME_VAL"
    read -r hn_in || true
    [ -n "${hn_in:-}" ] && HOSTNAME_VAL="$hn_in"
  fi
  HOSTNAME_VAL="$(printf '%s' "$HOSTNAME_VAL" | tr 'A-Z' 'a-z')"
  [[ "$HOSTNAME_VAL" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] \
    || die "invalid hostname '$HOSTNAME_VAL' (letters, digits, hyphen)."

  if [ -z "$USERNAME_IN" ]; then
    printf '  Admin username (lowercase, start with a letter) [admin]: '
    read -r USERNAME_VAL || true
  fi
  USERNAME_VAL="${USERNAME_VAL:-admin}"
  [[ "$USERNAME_VAL" =~ ^[a-z_][a-z0-9_-]*$ ]] \
    || die "invalid username '$USERNAME_VAL' (lowercase, start with a letter, e.g. admin)."

  if [ -z "$TIMEZONE_IN" ]; then
    printf '  Timezone [%s]: ' "$TIMEZONE_VAL"
    read -r tz_in || true
    [ -n "${tz_in:-}" ] && TIMEZONE_VAL="$tz_in"
  fi

  # Password twice, never echoed.
  printf '  Admin password: '; read -rs PASSWORD_VAL; printf '\n'
  printf '  Confirm password: '; read -rs PASSWORD_CONFIRM; printf '\n'
  [ -n "$PASSWORD_VAL" ] || die "password may not be empty."
  [ "$PASSWORD_VAL" = "$PASSWORD_CONFIRM" ] || die "passwords do not match."
else
  # Dry run: don't prompt for a password, just show a placeholder account.
  USERNAME_VAL="${USERNAME_VAL:-admin}"
fi

# Whatever the flashed edition carries is what installs. ROCm presence is a
# property of the image, detected here only to describe the plan honestly.
if command -v rocminfo >/dev/null 2>&1 || [ -e /opt/rocm ]; then
  EDITION_DESC="universal (ROCm present; used only on training-capable cards)"
else
  EDITION_DESC="lite (Vulkan-only)"
fi

# ---- show the plan ----------------------------------------------------------
echo
say "Cameo install plan  (offline — copies the live image, downloads nothing)"
info "Target disk:   ${C_BOLD}${TARGET}${C_OFF}  (${DISK_SIZE:-?}  ${DISK_MODEL:-unknown})"
info "Firmware:      ${FIRMWARE^^}  →  GRUB $( [ "$FIRMWARE" = uefi ] && echo 'x86_64-efi' || echo 'i386-pc' )"
if [ "$FIRMWARE" = "uefi" ]; then
  info "Partitions:    $(partdev 1)  512M  EFI (FAT32)      +  $(partdev 2)  rest  root (ext4)"
else
  info "Partitions:    $(partdev 1)  1M  BIOS-boot         +  $(partdev 2)  rest  root (ext4)"
fi
info "Source:        ${COPY_METHOD} $( [ "$COPY_METHOD" = unsquashfs ] && echo "$SFS_SRC" || echo '(live root)' )"
info "Edition:       ${EDITION_DESC}"
info "Hostname:      ${HOSTNAME_VAL}"
info "Admin user:    ${USERNAME_VAL}  (sudo via wheel)"
info "Timezone:      ${TIMEZONE_VAL}"
info "Console:       cameod enabled; persistent key written to /etc/cameo/cameod.env"
echo

if [ "$COMMIT" -eq 0 ]; then
  warn "DRY RUN — nothing was changed."
  info "Re-run with ${C_BOLD}--commit${C_OFF} to install. That will ERASE ${TARGET}."
  exit 0
fi

# ---- confirm the erase ------------------------------------------------------
base="$(basename "$TARGET")"
printf '%sThis will ERASE ALL DATA on %s.%s\n' "$C_WARN" "$TARGET" "$C_OFF"
printf '  Type the disk name (%s%s%s) to proceed: ' "$C_BOLD" "$base" "$C_OFF"
read -r confirm
[ "$confirm" = "$base" ] || die "confirmation did not match; aborting. Nothing was changed."

# ---- partition + format -----------------------------------------------------
say "Partitioning $TARGET"
# Release the target before wiping it: a live environment (or a previous install)
# may have auto-mounted its partitions or activated swap on them, which makes
# `wipefs` fail with "Device or resource busy". Unmount every partition, disable
# any swap, let udev settle, then force the wipe.
while read -r part; do
  [ -n "$part" ] || continue
  swapoff "$part" 2>/dev/null || true
  umount -f "$part" 2>/dev/null || true
done < <(lsblk -lnpo NAME "$TARGET" | tail -n +2)
udevadm settle 2>/dev/null || true
wipefs -af "$TARGET"
sgdisk --zap-all "$TARGET"
if [ "$FIRMWARE" = "uefi" ]; then
  sgdisk -n1:0:+512M -t1:ef00 -c1:EFI "$TARGET"
  sgdisk -n2:0:0     -t2:8300 -c2:cameo-root "$TARGET"
  partprobe "$TARGET" 2>/dev/null || true; sleep 1
  mkfs.fat -F32 "$(partdev 1)"
  mkfs.ext4 -F "$(partdev 2)"
  mount "$(partdev 2)" /mnt
  mkdir -p /mnt/boot
  mount "$(partdev 1)" /mnt/boot
else
  sgdisk -n1:0:+1M   -t1:ef02 -c1:BIOSboot "$TARGET"
  sgdisk -n2:0:0     -t2:8300 -c2:cameo-root "$TARGET"
  partprobe "$TARGET" 2>/dev/null || true; sleep 1
  mkfs.ext4 -F "$(partdev 2)"
  mount "$(partdev 2)" /mnt
fi

# ---- copy the system (offline) ----------------------------------------------
# The whole point: put the running image onto the disk without a single byte from
# the network. unsquashfs unpacks the pristine airootfs; rsync mirrors the live
# root as a fallback, skipping virtual and cross-mount paths.
if [ "$COPY_METHOD" = "unsquashfs" ]; then
  say "Unpacking the live image onto $TARGET (offline) — grab a coffee"
  unsquashfs -f -d /mnt "$SFS_SRC"
else
  say "Mirroring the live system onto $TARGET (offline) — grab a coffee"
  rsync -aHAX --numeric-ids --info=progress2 --one-file-system \
    --exclude='/mnt/*' --exclude='/lost+found' \
    / /mnt/
fi

# The kernel must be on /boot to boot. If the airootfs did not carry it (some
# builds prune it), lift it straight off the boot medium.
if [ ! -e /mnt/boot/vmlinuz-linux ] && [ -n "$KERNEL_SRC" ]; then
  install -Dm644 "$KERNEL_SRC" /mnt/boot/vmlinuz-linux
fi
[ -e /mnt/boot/vmlinuz-linux ] || die "no kernel on the target (/boot/vmlinuz-linux missing); cannot proceed."

genfstab -U /mnt > /mnt/etc/fstab

# ---- de-live the copy -------------------------------------------------------
# The image is built to run as a live USB. Strip the live-only behaviour so the
# installed box boots like a normal machine: a real initramfs (not the archiso
# one that hunts for a squashfs), a login prompt (not root autologin), and none
# of the USB bootstrap units.
say "Converting the copy into an installed system"

# 1) A normal initramfs. The copied /etc/mkinitcpio.conf uses the `archiso`
#    hooks, which look for the ISO at boot and would leave the disk unbootable.
cat > /mnt/etc/mkinitcpio.conf <<'EOF'
# Cameo installed-system initramfs (generic hooks; no archiso).
MODULES=()
BINARIES=()
FILES=()
HOOKS=(base udev autodetect microcode modconf kms keyboard keymap consolefont block filesystems fsck)
EOF
cat > /mnt/etc/mkinitcpio.d/linux.preset <<'EOF'
ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-linux"
PRESETS=('default' 'fallback')
default_image="/boot/initramfs-linux.img"
fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
EOF

# 2) No root autologin on an installed box — it has a real admin account.
rm -f /mnt/etc/systemd/system/getty@tty1.service.d/autologin.conf
rmdir /mnt/etc/systemd/system/getty@tty1.service.d 2>/dev/null || true

# 3) Drop live-only unit enablement (leave the unit files; just don't start them).
#    - cameo-installer: the "install to disk" flow itself (also gated on a kernel
#      arg the installed system never has, but disable it for good measure).
#    - cameo-console-init: regenerates a throwaway key each boot; the installed
#      system uses the persistent one written below.
#    - cameo-storage-init: live-USB persistence setup, meaningless on a disk.
#    - releng's boot-time chores that only make sense on live media.
for unit in cameo-installer.service cameo-console-init.service cameo-storage-init.service \
            pacman-init.service choose-mirror.service reflector.service \
            livecd-talk.service; do
  rm -f "/mnt/etc/systemd/system/multi-user.target.wants/$unit" \
        "/mnt/etc/systemd/system/$unit" 2>/dev/null || true
done
# cameo-installer may also be wired in via a getty drop-in / wants — clear those.
rm -f /mnt/etc/systemd/system/getty.target.wants/cameo-installer.service 2>/dev/null || true

# 4) Fresh first boot: re-arm the one-shot tier report so the installed box
#    greets the operator with its tier + console URL on first power-on.
rm -f /mnt/var/lib/cameo/.firstboot-done 2>/dev/null || true

# ---- console key + model cache ----------------------------------------------
# A persistent console key, generated once at install (no more per-boot churn).
say "Writing a persistent console key"
key="$(head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32)"
install -d -m755 /mnt/etc/cameo
umask 077
cat > /mnt/etc/cameo/cameod.env <<EOF
# Cameo console — persistent settings written by cameo-install.
# This key is stable across reboots. cameo-hello prints it at login.
CAMEO_CONSOLE_HOST=0.0.0.0
CAMEO_CONSOLE_KEY=$key
CAMEO_CONSOLE_PORT=9090
# CAMEO_AUTOSTART_MODEL=none
EOF
umask 022

# ---- configure the installed system -----------------------------------------
say "Configuring the system"
# `ln -sf` to a nonexistent target still succeeds (it happily creates a dangling
# symlink), so an unknown timezone must be caught by checking the zoneinfo file
# in the *target* system — the fallback branch never fired otherwise.
if [ -e "/mnt/usr/share/zoneinfo/${TIMEZONE_VAL}" ]; then
  ln -sf "/usr/share/zoneinfo/${TIMEZONE_VAL}" /mnt/etc/localtime
else
  warn "unknown timezone '${TIMEZONE_VAL}' — defaulting to UTC."
  ln -sf /usr/share/zoneinfo/UTC /mnt/etc/localtime
fi
grep -q '^en_US.UTF-8 UTF-8' /mnt/etc/locale.gen 2>/dev/null \
  || echo "en_US.UTF-8 UTF-8" >> /mnt/etc/locale.gen
echo "LANG=en_US.UTF-8" > /mnt/etc/locale.conf
echo "$HOSTNAME_VAL" > /mnt/etc/hostname
cat > /mnt/etc/hosts <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${HOSTNAME_VAL}.localdomain ${HOSTNAME_VAL}
EOF

# DHCP on Ethernet (networkd) and on Wi-Fi (iwd). Without iwd's own IP config,
# `iwctl` can show "connected" with no address — pacman then hangs or no-ops.
install -Dm644 /dev/stdin /mnt/etc/systemd/network/20-wired.network <<'EOF'
[Match]
Type=ether

[Network]
DHCP=yes
MulticastDNS=yes
EOF
install -Dm644 /dev/stdin /mnt/etc/systemd/resolved.conf.d/mdns.conf <<'EOF'
[Resolve]
MulticastDNS=yes
EOF
install -Dm644 /dev/stdin /mnt/etc/iwd/main.conf <<'EOF'
[General]
EnableNetworkConfiguration=true

[Network]
NameResolvingService=systemd
EOF
ln -sf /run/systemd/resolve/stub-resolv.conf /mnt/etc/resolv.conf

# The squashfs copy is pristine — live pacman-init only filled the USB overlay.
# Initialise the keyring from the archlinux-keyring files already on disk so
# `pacman -Sy` works the first time the box has a network. No download.
say "Initialising pacman keyring (offline)"
arch-chroot /mnt pacman-key --init
arch-chroot /mnt pacman-key --populate archlinux

# Configure the target with discrete arch-chroot calls rather than one big
# heredoc. This is deliberate: the admin password is piped straight to chpasswd
# as stdin and never interpolated through a shell, so a password containing $,
# backticks, quotes or spaces cannot corrupt the script or leak.
install -Dm440 /dev/stdin /mnt/etc/sudoers.d/10-wheel <<< '%wheel ALL=(ALL:ALL) ALL'

arch-chroot /mnt hwclock --systohc 2>/dev/null || true
arch-chroot /mnt locale-gen
# The shared model cache. cameod.service's ExecStartPre would create it root-only
# on first boot; making it setgid + wheel-writable here means the admin's own
# `cameo pull` and the root daemon share one persistent cache instead of the CLI
# failing with EACCES (or silently splitting off into ~/.cache).
arch-chroot /mnt install -d -m 2775 -g wheel /var/lib/cameo/models
# Admin account with sudo; root shares the same password so a fresh install is
# never locked out at the console.
arch-chroot /mnt useradd -m -G wheel -s /bin/bash "$USERNAME_VAL"
printf '%s:%s\n' "$USERNAME_VAL" "$PASSWORD_VAL" | arch-chroot /mnt chpasswd
printf 'root:%s\n' "$PASSWORD_VAL" | arch-chroot /mnt chpasswd
# Enable exactly the services an installed box wants; the live-only ones were
# stripped above. cameo-firstboot prints the tier banner once on first boot.
arch-chroot /mnt systemctl enable systemd-networkd systemd-resolved iwd cameod cameo-firstboot 2>/dev/null || \
  arch-chroot /mnt systemctl enable systemd-networkd systemd-resolved iwd cameod
arch-chroot /mnt mkinitcpio -P
if [ "$FIRMWARE" = "uefi" ]; then
  arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot \
    --bootloader-id=Cameo --removable
else
  arch-chroot /mnt grub-install --target=i386-pc "$TARGET"
fi
# The live USB is still plugged in. os-prober would add it as a boot entry and
# grub-mkconfig can emit an archiso/squashfs menu that keeps depending on the
# stick — then "remove USB and reboot" explodes into SQUASHFS read errors.
arch-chroot /mnt env GRUB_DISABLE_OS_PROBER=true grub-mkconfig -o /boot/grub/grub.cfg
grub_cfg=""
for g in /mnt/boot/grub/grub.cfg /mnt/grub/grub.cfg; do
  [ -f "$g" ] && grub_cfg="$g" && break
done
if [ -n "$grub_cfg" ] && grep -qiE 'archiso|airootfs\.sfs|archisobasedir' "$grub_cfg"; then
  die "grub.cfg still points at the live ISO ($grub_cfg). Not safe to unplug the USB."
fi

# ---- finish -----------------------------------------------------------------
sync
umount -R /mnt 2>/dev/null || true

echo
say "Cameo is installed on ${TARGET}."
info "Leave the USB plugged in. Reboot first."
info "When the screen goes dark or you see the firmware logo, THEN unplug the USB."
info "Pulling it now kills the live OS (SQUASHFS unable to read page/block …)."
info "Log in as ${C_BOLD}${USERNAME_VAL}${C_OFF} (or root) with the password you set."
info "Web console:  http://<this-box-ip>:9090   or   http://${HOSTNAME_VAL}.local:9090"
info "Console key:  ${key}"
info "  (stored in /etc/cameo/cameod.env — stable across reboots now)"
info "After login the URL and key print again."
info "Wi-Fi is only for attaching this box as a fleet node (then: iwctl)."
info "On the console: press “Start qwen2.5-0.5b and chat”."
echo
