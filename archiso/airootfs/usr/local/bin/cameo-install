#!/usr/bin/env bash
# cameo-install — install Cameo from the live medium onto a disk.
#
# This turns Cameo from a live USB into a real, persistent OS: it partitions a
# target disk, pacstraps the base + AMD/inference stack onto it, installs a
# bootloader (GRUB, UEFI *or* BIOS — detected), creates your admin account, and
# enables the cameod console. After it finishes you reboot into an installed
# system and never touch the USB again. Accounts, keys, models and config then
# persist like any normal machine.
#
# SAFETY. This erases a whole disk, so it is built to be hard to misfire:
#   * It DEFAULTS TO A DRY RUN — it prints the exact plan and changes nothing.
#     Add --commit to actually install.
#   * --commit still requires you to type the target disk's name to confirm.
#   * It refuses to install onto the device you booted from.
# Run the dry run first, read it, then re-run with --commit.
#
#   cameo-install                      # dry run: show the plan, touch nothing
#   cameo-install --disk /dev/sda      # dry run against a specific disk
#   cameo-install --commit --disk /dev/sda   # do it (after typed confirmation)
set -euo pipefail

# ---- presentation -----------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_ACCENT=$'\033[1;38;5;209m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
  C_WARN=$'\033[1;33m'; C_ERR=$'\033[1;31m'; C_OK=$'\033[1;32m'; C_OFF=$'\033[0m'
else
  C_ACCENT=""; C_BOLD=""; C_DIM=""; C_WARN=""; C_ERR=""; C_OK=""; C_OFF=""
fi
say()  { printf '%s%s%s\n' "$C_ACCENT" "$*" "$C_OFF"; }
info() { printf '  %s\n' "$*"; }
warn() { printf '%s! %s%s\n' "$C_WARN" "$*" "$C_OFF" >&2; }
die()  { printf '%sERROR:%s %s\n' "$C_ERR" "$C_OFF" "$*" >&2; exit 1; }

# ---- arguments --------------------------------------------------------------
COMMIT=0
TARGET=""
HOSTNAME_IN=""
USERNAME_IN=""
TIMEZONE_IN=""
while [ $# -gt 0 ]; do
  case "$1" in
    --commit)   COMMIT=1 ;;
    --disk)     TARGET="${2:-}"; shift ;;
    --hostname) HOSTNAME_IN="${2:-}"; shift ;;
    --user)     USERNAME_IN="${2:-}"; shift ;;
    --timezone) TIMEZONE_IN="${2:-}"; shift ;;
    -h|--help)
      grep '^#' "$0" | sed 's/^# \{0,1\}//' | sed '/^!/d'
      exit 0 ;;
    *) die "unknown argument: $1 (see --help)" ;;
  esac
  shift
done

# ---- preflight --------------------------------------------------------------
[ "$(id -u)" -eq 0 ] || die "run as root."
[ "$(uname -m)" = "x86_64" ] || die "this build targets x86_64."

for tool in sgdisk mkfs.ext4 pacstrap genfstab arch-chroot lsblk findmnt; do
  command -v "$tool" >/dev/null 2>&1 \
    || die "missing '$tool'. The live image must ship arch-install-scripts, gptfdisk and dosfstools."
done

# Firmware mode decides the partition layout and how GRUB is installed.
if [ -d /sys/firmware/efi ]; then
  FIRMWARE="uefi"
else
  FIRMWARE="bios"
fi

# The device the live system booted from — never a valid install target.
live_disk() {
  local src parent
  src="$(findmnt -n -o SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
  [ -n "$src" ] || src="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
  [ -n "$src" ] || return 0
  parent="$(lsblk -no PKNAME "$src" 2>/dev/null | head -1 || true)"
  [ -n "$parent" ] && printf '/dev/%s\n' "$parent"
}
LIVE_DISK="$(live_disk || true)"

# ---- choose the disk --------------------------------------------------------
list_disks() {
  # Whole disks only, excluding the live medium, as "NAME SIZE MODEL".
  lsblk -dpno NAME,SIZE,MODEL,TYPE | awk -v live="$LIVE_DISK" \
    '$4=="disk" && $1!=live { $4=""; sub(/[ \t]+$/,""); print }'
}

if [ -z "$TARGET" ]; then
  say "Target disks"
  mapfile -t DISKS < <(list_disks | awk '{print $1}')
  [ "${#DISKS[@]}" -gt 0 ] || die "no installable disk found (only the live medium is present?)."
  list_disks | nl -w2 -s'. ' | sed 's/^/  /'
  printf '  %sPick a disk number: %s' "$C_BOLD" "$C_OFF"
  read -r pick
  [[ "$pick" =~ ^[0-9]+$ ]] && [ "$pick" -ge 1 ] && [ "$pick" -le "${#DISKS[@]}" ] \
    || die "not a listed choice."
  TARGET="${DISKS[$((pick - 1))]}"
fi

[ -b "$TARGET" ] || die "$TARGET is not a block device."
if [ -n "$LIVE_DISK" ] && [ "$TARGET" = "$LIVE_DISK" ]; then
  die "$TARGET is the device you booted from — refusing to erase it."
fi

# nvme0n1 → nvme0n1p1 ; sda → sda1
partdev() {
  case "$TARGET" in
    *[0-9]) printf '%sp%s\n' "$TARGET" "$1" ;;
    *)      printf '%s%s\n' "$TARGET" "$1" ;;
  esac
}

DISK_SIZE="$(lsblk -dno SIZE "$TARGET" 2>/dev/null | tr -d ' ')"
DISK_MODEL="$(lsblk -dno MODEL "$TARGET" 2>/dev/null | sed 's/[ \t]*$//')"

# ---- gather settings --------------------------------------------------------
HOSTNAME_VAL="${HOSTNAME_IN:-cameo}"
USERNAME_VAL="${USERNAME_IN:-}"
TIMEZONE_VAL="${TIMEZONE_IN:-UTC}"

if [ "$COMMIT" -eq 1 ]; then
  if [ -z "$USERNAME_VAL" ]; then
    printf '  Admin username: '
    read -r USERNAME_VAL
  fi
  [[ "$USERNAME_VAL" =~ ^[a-z_][a-z0-9_-]*$ ]] \
    || die "invalid username '$USERNAME_VAL' (lowercase, start with a letter)."
  # Password twice, never echoed.
  printf '  Admin password: '; read -rs PASSWORD_VAL; printf '\n'
  printf '  Confirm password: '; read -rs PASSWORD_CONFIRM; printf '\n'
  [ -n "$PASSWORD_VAL" ] || die "password may not be empty."
  [ "$PASSWORD_VAL" = "$PASSWORD_CONFIRM" ] || die "passwords do not match."
else
  # Dry run: don't prompt for a password, just show a placeholder account.
  USERNAME_VAL="${USERNAME_VAL:-admin}"
fi

# Tier-appropriate package set. A Tier-3 (Vulkan-only) box — a typical junk
# laptop APU — must NOT pull the multi-gigabyte ROCm stack it cannot use, so
# ROCm is added only when detection reports a training-capable (Tier 1/2) GPU.
BASE_PKGS=(
  base linux linux-firmware linux-headers mkinitcpio amd-ucode
  grub sudo zsh bash
  mesa vulkan-radeon vulkan-icd-loader vulkan-tools
  llama-cpp ggml-vulkan
  iwd wireless-regdb
  git curl nano vim less openssh man-db man-pages
)
[ "$FIRMWARE" = "uefi" ] && BASE_PKGS+=(efibootmgr dosfstools)
ROCM_PKGS=(rocm-hip-sdk rocminfo rocm-smi-lib ggml-hip python python-pytorch-rocm)

INCLUDE_ROCM=0
if command -v cameo >/dev/null 2>&1 \
   && cameo gpu-status --json 2>/dev/null | grep -q '"training_supported": *true'; then
  INCLUDE_ROCM=1
fi
PKGS=("${BASE_PKGS[@]}")
[ "$INCLUDE_ROCM" -eq 1 ] && PKGS+=("${ROCM_PKGS[@]}")

# ---- show the plan ----------------------------------------------------------
echo
say "Cameo install plan"
info "Target disk:   ${C_BOLD}${TARGET}${C_OFF}  (${DISK_SIZE:-?}  ${DISK_MODEL:-unknown})"
info "Firmware:      ${FIRMWARE^^}  →  GRUB $( [ "$FIRMWARE" = uefi ] && echo 'x86_64-efi' || echo 'i386-pc' )"
if [ "$FIRMWARE" = "uefi" ]; then
  info "Partitions:    $(partdev 1)  512M  EFI (FAT32)      +  $(partdev 2)  rest  root (ext4)"
else
  info "Partitions:    $(partdev 1)  1M  BIOS-boot         +  $(partdev 2)  rest  root (ext4)"
fi
info "Hostname:      ${HOSTNAME_VAL}"
info "Admin user:    ${USERNAME_VAL}  (sudo via wheel)"
info "Timezone:      ${TIMEZONE_VAL}"
info "ROCm stack:    $( [ "$INCLUDE_ROCM" -eq 1 ] && echo 'yes (Tier 1/2 GPU detected)' || echo 'no (Vulkan-only / Tier 3)' )"
info "Packages:      ${#PKGS[@]} ($( [ "$INCLUDE_ROCM" -eq 1 ] && echo 'full' || echo 'Vulkan baseline' ))"
info "Console:       cameod enabled; persistent key written to /etc/cameo/cameod.env"
echo

if [ "$COMMIT" -eq 0 ]; then
  warn "DRY RUN — nothing was changed."
  info "Re-run with ${C_BOLD}--commit${C_OFF} to install. That will ERASE ${TARGET}."
  exit 0
fi

# ---- confirm the erase ------------------------------------------------------
base="$(basename "$TARGET")"
printf '%sThis will ERASE ALL DATA on %s.%s\n' "$C_WARN" "$TARGET" "$C_OFF"
printf '  Type the disk name (%s%s%s) to proceed: ' "$C_BOLD" "$base" "$C_OFF"
read -r confirm
[ "$confirm" = "$base" ] || die "confirmation did not match; aborting. Nothing was changed."

# ---- network preflight (BEFORE we touch the disk) ---------------------------
# pacstrap downloads the whole system from the Arch mirrors, so with no network
# it fails partway — and if that happens *after* partitioning, the disk is wiped
# with no OS on it. Prove connectivity first, and refuse (having changed nothing)
# with guidance if it is missing. This is the single most common install failure
# on a laptop with no ethernet: wifi is simply not associated yet.
say "Checking network"
reach() { curl -fsS --max-time 10 -o /dev/null "$1" 2>/dev/null; }
if ! reach https://geo.mirror.pkgbuild.com/ && ! reach https://archlinux.org/ \
   && ! reach https://mirror.rackspace.com/archlinux/; then
  echo
  warn "No internet connection — pacstrap cannot download the system."
  info "Nothing has been changed on ${TARGET}. Connect a network, then re-run."
  info "  Wired:  plug in ethernet (DHCP is automatic)."
  info "  Wi-Fi:  ${C_BOLD}iwctl${C_OFF} → 'station wlan0 get-networks' →"
  info "          'station wlan0 connect <SSID>'  (then re-run cameo-install --commit)."
  info "  Verify: ${C_BOLD}ping -c1 archlinux.org${C_OFF}"
  die "network required."
fi
info "Network OK."

# ---- partition + format -----------------------------------------------------
say "Partitioning $TARGET"
# Release the target before wiping it: a live environment (or a previous install)
# may have auto-mounted its partitions or activated swap on them, which makes
# `wipefs` fail with "Device or resource busy". Unmount every partition, disable
# any swap, let udev settle, then force the wipe.
while read -r part; do
  [ -n "$part" ] || continue
  swapoff "$part" 2>/dev/null || true
  umount -f "$part" 2>/dev/null || true
done < <(lsblk -lnpo NAME "$TARGET" | tail -n +2)
udevadm settle 2>/dev/null || true
wipefs -af "$TARGET"
sgdisk --zap-all "$TARGET"
if [ "$FIRMWARE" = "uefi" ]; then
  sgdisk -n1:0:+512M -t1:ef00 -c1:EFI "$TARGET"
  sgdisk -n2:0:0     -t2:8300 -c2:cameo-root "$TARGET"
  partprobe "$TARGET" 2>/dev/null || true; sleep 1
  mkfs.fat -F32 "$(partdev 1)"
  mkfs.ext4 -F "$(partdev 2)"
  mount "$(partdev 2)" /mnt
  mkdir -p /mnt/boot
  mount "$(partdev 1)" /mnt/boot
else
  sgdisk -n1:0:+1M   -t1:ef02 -c1:BIOSboot "$TARGET"
  sgdisk -n2:0:0     -t2:8300 -c2:cameo-root "$TARGET"
  partprobe "$TARGET" 2>/dev/null || true; sleep 1
  mkfs.ext4 -F "$(partdev 2)"
  mount "$(partdev 2)" /mnt
fi

# ---- install the system -----------------------------------------------------
say "Installing packages (pacstrap) — this downloads a lot; grab a coffee"
pacstrap -K /mnt "${PKGS[@]}"
genfstab -U /mnt >> /mnt/etc/fstab

# Carry the Cameo pieces that are not pacman packages: the CLI, the daemon, the
# console/first-boot units and branding, exactly as configured on this medium.
say "Copying the Cameo layer into the installed system"
for f in cameo cameod cameo-firstboot cameo-install; do
  [ -e "/usr/local/bin/$f" ] && install -Dm755 "/usr/local/bin/$f" "/mnt/usr/local/bin/$f"
done
[ -d /etc/cameo ] && cp -a /etc/cameo /mnt/etc/
for u in cameod.service cameo-firstboot.service; do
  [ -e "/etc/systemd/system/$u" ] && install -Dm644 "/etc/systemd/system/$u" "/mnt/etc/systemd/system/$u"
done
for cfg in /etc/modprobe.d/cameo-amdgpu.conf /etc/sysctl.d/30-cameo.conf /etc/os-release /etc/motd; do
  [ -e "$cfg" ] && install -Dm644 "$cfg" "/mnt$cfg"
done

# A persistent console key, generated once at install (no more per-boot churn).
say "Writing a persistent console key"
key="$(head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32)"
install -d -m755 /mnt/etc/cameo
umask 077
cat > /mnt/etc/cameo/cameod.env <<EOF
# Cameo console — persistent settings written by cameo-install.
CAMEO_CONSOLE_HOST=0.0.0.0
CAMEO_CONSOLE_KEY=$key
CAMEO_CONSOLE_PORT=9090
EOF
umask 022

# ---- configure the installed system -----------------------------------------
say "Configuring the system"
ln -sf "/usr/share/zoneinfo/${TIMEZONE_VAL}" /mnt/etc/localtime 2>/dev/null || \
  ln -sf /usr/share/zoneinfo/UTC /mnt/etc/localtime
echo "en_US.UTF-8 UTF-8" >> /mnt/etc/locale.gen
echo "LANG=en_US.UTF-8" > /mnt/etc/locale.conf
echo "$HOSTNAME_VAL" > /mnt/etc/hostname
cat > /mnt/etc/hosts <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${HOSTNAME_VAL}.localdomain ${HOSTNAME_VAL}
EOF

# A basic DHCP profile so the installed box has networking; iwd handles wifi.
install -Dm644 /dev/stdin /mnt/etc/systemd/network/20-wired.network <<'EOF'
[Match]
Type=ether

[Network]
DHCP=yes
EOF

# Configure the target with discrete arch-chroot calls rather than one big
# heredoc. This is deliberate: the admin password is piped straight to chpasswd
# as stdin and never interpolated through a shell, so a password containing $,
# backticks, quotes or spaces cannot corrupt the script or leak.
install -Dm440 /dev/stdin /mnt/etc/sudoers.d/10-wheel <<< '%wheel ALL=(ALL:ALL) ALL'

arch-chroot /mnt hwclock --systohc 2>/dev/null || true
arch-chroot /mnt locale-gen
# Admin account with sudo; root shares the same password so a fresh install is
# never locked out at the console.
arch-chroot /mnt useradd -m -G wheel -s /bin/bash "$USERNAME_VAL"
printf '%s:%s\n' "$USERNAME_VAL" "$PASSWORD_VAL" | arch-chroot /mnt chpasswd
printf 'root:%s\n' "$PASSWORD_VAL" | arch-chroot /mnt chpasswd
arch-chroot /mnt systemctl enable systemd-networkd systemd-resolved iwd cameod
arch-chroot /mnt mkinitcpio -P
if [ "$FIRMWARE" = "uefi" ]; then
  arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot \
    --bootloader-id=Cameo --removable
else
  arch-chroot /mnt grub-install --target=i386-pc "$TARGET"
fi
arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg

# ---- finish -----------------------------------------------------------------
sync
umount -R /mnt 2>/dev/null || true

echo
say "Cameo is installed on ${TARGET}."
info "Remove the USB and reboot."
info "Log in as ${C_BOLD}${USERNAME_VAL}${C_OFF} (or root) with the password you set."
info "Web console:  http://<this-box-ip>:9090"
info "Console key:  ${key}"
info "  (stored in /etc/cameo/cameod.env — stable across reboots now)"
echo
