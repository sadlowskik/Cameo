#!/usr/bin/env bash
# Print how to open the console: wordmark, URL, key, certificate fingerprint.
# Run from first-boot and every interactive login (profile.d).
# Must never fail a login.
set +e

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_ACCENT=$'\033[1;38;5;209m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
else
  C_ACCENT=""; C_DIM=""; C_OFF=""
fi

# Env layers match cameod.service: generated /run first, /etc last wins.
# shellcheck source=/dev/null
[ -r /run/cameo/cameod.env ] && . /run/cameo/cameod.env
# shellcheck source=/dev/null
[ -r /etc/cameo/cameod.env ] && . /etc/cameo/cameod.env

host="${CAMEO_CONSOLE_HOST:-127.0.0.1}"
port="${CAMEO_CONSOLE_PORT:-9090}"
scheme="https"
[ "${CAMEO_TLS:-on}" = "off" ] && scheme="http"

# First global IPv4 on a real interface, via iproute2 (`hostname` is not on the
# image). Retry a few seconds: first boot often races DHCP.
lan_ip() {
  ip -4 -o addr show scope global 2>/dev/null | awk '{ sub(/\/.*/, "", $4); print $4; exit }'
}

ip="$(lan_ip)"
tries="${CAMEO_HELLO_WAIT:-12}"
i=0
while [ -z "$ip" ] && [ "$i" -lt "$tries" ]; do
  sleep 1
  ip="$(lan_ip)"
  i=$((i + 1))
done

loopback_only=0
case "$host" in
  127.0.0.1 | localhost | ::1) loopback_only=1 ;;
esac
if [ "$loopback_only" -eq 1 ]; then
  shown="$host"
else
  shown="${ip:-<this-box-ip>}"
fi

# The certificate cameod actually presents, read back over loopback so this works
# for any user (the key material itself is owner-only). SHA-256 fingerprint.
fingerprint=""
if [ "$scheme" = "https" ] && command -v openssl >/dev/null 2>&1; then
  fingerprint="$(openssl s_client -connect "127.0.0.1:${port}" -servername cameo.local </dev/null 2>/dev/null \
    | openssl x509 -noout -fingerprint -sha256 2>/dev/null | sed 's/^.*=//')"
fi

rule() { printf '%s────────────────────────────────────────%s\n' "$C_DIM" "$C_OFF"; }

echo
if [ -z "${CAMEO_HELLO_NO_ART:-}" ]; then
  printf '%s' "$C_ACCENT"
  cat <<'ART'
 ██████╗ █████╗ ███╗   ███╗███████╗ ██████╗
██╔════╝██╔══██╗████╗ ████║██╔════╝██╔═══██╗
██║     ███████║██╔████╔██║█████╗  ██║   ██║
██║     ██╔══██║██║╚██╔╝██║██╔══╝  ██║   ██║
╚██████╗██║  ██║██║ ╚═╝ ██║███████╗╚██████╔╝
 ╚═════╝╚═╝  ╚═╝╚═╝     ╚═╝╚══════╝ ╚═════╝
ART
  printf '%s' "$C_OFF"
  printf '  %sany AMD card → a working LLM box%s\n' "$C_DIM" "$C_OFF"
  echo
fi
rule
printf '%s  Web console%s\n' "$C_ACCENT" "$C_OFF"
echo "    ${scheme}://${shown}:${port}"
if [ "$loopback_only" -eq 0 ]; then
  echo "    ${scheme}://cameo.local:${port}"
fi
if [ -n "${CAMEO_CONSOLE_KEY:-}" ]; then
  printf '    Console key:  %s%s%s\n' "$C_ACCENT" "$CAMEO_CONSOLE_KEY" "$C_OFF"
fi
if [ -n "$fingerprint" ]; then
  echo "    Certificate:  ${fingerprint}"
  echo "    ${C_DIM}Self-signed: your browser warns once. Accept it only if the fingerprint matches.${C_OFF}"
elif [ "$scheme" = "https" ]; then
  echo "    ${C_DIM}Certificate fingerprint appears once cameod is up (systemctl status cameod).${C_OFF}"
fi
if [ -d /run/archiso ]; then
  echo "    ${C_DIM}Live USB — key and certificate last until reboot. Install to keep them.${C_OFF}"
else
  echo "    ${C_DIM}Key in /etc/cameo/cameod.env, certificate in /var/lib/cameo/tls — stable across reboots.${C_OFF}"
fi
echo
if [ "$loopback_only" -eq 1 ]; then
  echo "    Listener is loopback-only (CAMEO_CONSOLE_HOST=127.0.0.1 in /etc/cameo/cameod.env)."
  echo "    Set it to 0.0.0.0 to reach the console from another machine."
else
  echo "    Reachable from any machine on this LAN; the key is required for every action."
  echo "    Never port-forward this to the internet."
fi
echo "    Starter is a smoke test: Start qwen2.5-0.5b and chat."
rule

if [ -z "$ip" ]; then
  echo
  printf '%s  No LAN address yet.%s Plug Ethernet, or for Wi-Fi: iwctl\n' "$C_ACCENT" "$C_OFF"
fi
echo
exit 0
