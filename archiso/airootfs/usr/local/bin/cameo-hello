#!/usr/bin/env bash
# Print how to open the console: wordmark, URL, key, next click.
# Sourced from first-boot and every interactive login (profile.d).
# Must never fail a login.
set +e

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_ACCENT=$'\033[1;38;5;209m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
else
  C_ACCENT=""; C_DIM=""; C_OFF=""
fi

# Env layers match cameod.service: generated /run first, /etc last wins.
# shellcheck source=/dev/null
[ -r /run/cameo/cameod.env ] && . /run/cameo/cameod.env
# shellcheck source=/dev/null
[ -r /etc/cameo/cameod.env ] && . /etc/cameo/cameod.env

host="${CAMEO_CONSOLE_HOST:-127.0.0.1}"
port="${CAMEO_CONSOLE_PORT:-9090}"

# IPv4 on a real interface. Retry a few seconds: first-boot often races DHCP.
lan_ip() {
  hostname -I 2>/dev/null | awk '{
    for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $i !~ /^127\./) { print $i; exit }
  }'
}

ip="$(lan_ip)"
tries="${CAMEO_HELLO_WAIT:-12}"
i=0
while [ -z "$ip" ] && [ "$i" -lt "$tries" ]; do
  sleep 1
  ip="$(lan_ip)"
  i=$((i + 1))
done

if [ "$host" = "0.0.0.0" ] || [ "$host" = "::" ]; then
  shown="${ip:-<this-box-ip>}"
else
  shown="$host"
fi

rule() { printf '%s────────────────────────────────────────%s\n' "$C_DIM" "$C_OFF"; }

echo
if [ -z "${CAMEO_HELLO_NO_ART:-}" ]; then
  printf '%s' "$C_ACCENT"
  cat <<'ART'
 ██████╗ █████╗ ███╗   ███╗███████╗ ██████╗
██╔════╝██╔══██╗████╗ ████║██╔════╝██╔═══██╗
██║     ███████║██╔████╔██║█████╗  ██║   ██║
██║     ██╔══██║██║╚██╔╝██║██╔══╝  ██║   ██║
╚██████╗██║  ██║██║ ╚═╝ ██║███████╗╚██████╔╝
 ╚═════╝╚═╝  ╚═╝╚═╝     ╚═╝╚══════╝ ╚═════╝
ART
  printf '%s' "$C_OFF"
  printf '  %sany AMD card → a working LLM box%s\n' "$C_DIM" "$C_OFF"
  echo
fi
rule
printf '%s  Web console%s\n' "$C_ACCENT" "$C_OFF"
echo "    http://${shown}:${port}"
echo "    http://cameo.local:${port}"
if [ -n "${CAMEO_CONSOLE_KEY:-}" ]; then
  printf '    Console key:  %s%s%s\n' "$C_ACCENT" "$CAMEO_CONSOLE_KEY" "$C_OFF"
fi
if [ -d /run/archiso ]; then
  echo "    ${C_DIM}Live USB — this key lasts until reboot. Install to keep it.${C_OFF}"
else
  echo "    ${C_DIM}Key in /etc/cameo/cameod.env — stable across reboots.${C_OFF}"
fi
echo
echo "    Open from a phone or laptop on this LAN. No internet."
echo "    Starter is a smoke test: Start qwen2.5-0.5b and chat."
rule

if [ -z "$ip" ]; then
  echo
  printf '%s  No LAN address yet.%s Plug Ethernet for the console on this LAN.\n' "$C_ACCENT" "$C_OFF"
  echo "    Wi-Fi is only for attaching this box as a fleet node — then: iwctl"
fi
echo
exit 0
