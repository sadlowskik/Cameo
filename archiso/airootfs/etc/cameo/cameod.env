# Cameo control-plane (cameod) — operator overrides.
#
# By DEFAULT you do not need to touch this file.
#
# Live USB: cameo-console-init writes a fresh key + all-interfaces bind to
# /run/cameo/cameod.env each boot (tmpfs — gone on reboot). This file is layered
# ON TOP, so anything you uncomment here WINS.
#
# Installed system: cameo-install writes a persistent CAMEO_CONSOLE_KEY here.
# That key is stable across reboots. cameo-hello prints it at every login.
#
# Force loopback-only (this box only):
#CAMEO_CONSOLE_HOST=127.0.0.1
#
# Pin a fixed key (live USB) or rotate the installed one:
#CAMEO_CONSOLE_KEY=change-me-to-a-long-random-string
#
# Change the port (default 9090):
#CAMEO_CONSOLE_PORT=9090
#
# Skip autostarting the starter model (playground then needs one click):
#CAMEO_AUTOSTART_MODEL=none
#
# Log verbosity (error|warn|info|debug|trace), default info:
#CAMEO_LOG=info
