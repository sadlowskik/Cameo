# Cameo control-plane (cameod) — operator overrides.
#
# By DEFAULT you do not need to touch this file. On each boot, cameo-console-init
# generates a random console key and binds the console to all interfaces, so the
# box is a ready "home console": open the URL printed on first boot from your own
# machine's browser and enter the key once. That generated config lives in
# /run/cameo/cameod.env (ephemeral).
#
# This file is layered ON TOP of the generated one, so anything you uncomment here
# WINS. Use it to override the defaults, then: systemctl restart cameod
#
# Force loopback-only (reachable solely from this box — e.g. if you run a browser
# locally, or the box is on an untrusted network):
#CAMEO_CONSOLE_HOST=127.0.0.1
#
# Pin a fixed, memorable key instead of the per-boot random one (so the key is
# stable across reboots):
#CAMEO_CONSOLE_KEY=change-me-to-a-long-random-string
#
# Change the port (default 9090):
#CAMEO_CONSOLE_PORT=9090
#
# Log verbosity (error|warn|info|debug|trace), default info:
#CAMEO_LOG=info
