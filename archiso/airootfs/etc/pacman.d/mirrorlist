# Cameo live image mirrorlist.
#
# Arch ships this file with every Server line commented out and relies on
# reflector to populate it at boot. Cameo strips releng's unit enablement
# (see scripts/build-iso.sh) so reflector never runs, which would leave the
# live image with no usable mirrors at all. A small static list is also more
# predictable for a distro whose point is not fighting the stack.
#
# Replace with reflector output if you want geo-optimised mirrors:
#   reflector --latest 20 --sort rate --save /etc/pacman.d/mirrorlist

Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
