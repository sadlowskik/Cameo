[Unit]
Description=Cameo control-plane console (cameod)
Documentation=https://github.com/sadlowskik/Cameo
# Detection reads local tools (lspci/rocminfo/rocm-smi) and binds a socket.
After=network.target cameo-console-init.service cameo-storage-init.service cameo-seed-models.service
Wants=network.target cameo-storage-init.service cameo-seed-models.service

[Service]
Type=simple
User=cameo
Group=cameo
# GPU device nodes are group-owned by render/video; DeviceAllow below only
# whitelists them in the cgroup, it does not grant file permission.
SupplementaryGroups=render video
# ROCm's tools install to /opt/rocm/bin and reach login shells only through
# profile.d, which units never source. Put them on the daemon's PATH.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/opt/rocm/bin
# Serve HTTPS with a self-signed certificate minted into this directory on first
# start (persistent on an installed system, per-boot on the live overlay).
Environment=CAMEO_TLS_DIR=/var/lib/cameo/tls
# Two env layers, later wins for a duplicate key:
#   1. /run/cameo/cameod.env — generated each boot by cameo-console-init: a random
#      key + a loopback bind for SSH/VPN or TLS-proxy access.
#   2. /etc/cameo/cameod.env — operator overrides (for example, a fixed key).
# Both optional ('-'): with neither, cameod falls back to a safe loopback bind.
EnvironmentFile=-/run/cameo/cameod.env
EnvironmentFile=-/etc/cameo/cameod.env
# One shared, persistent cache for the daemon AND the CLI: models_dir() prefers
# /var/lib/cameo/models whenever it exists, so creating it here makes every
# front end agree on it. (The old CAMEO_MODELS_DIR=/root/.cache override pinned
# an installed system's models to root's home — and, because this unit is copied
# to disk by cameo-install, defeated F2's persistent default there.) `mkdir -p`
# rather than `install -d` so an existing directory's mode/group — the installer
# makes it wheel-writable — is never clobbered.
StateDirectory=cameo
StateDirectoryMode=0750
# /run/cameo is created by tmpfiles.d, deliberately NOT as RuntimeDirectory=:
# systemd deletes a RuntimeDirectory whenever the unit stops, which wiped the
# console key cameo-console-init writes there on every restart.
ExecStartPre=+/usr/bin/install -d -o cameo -g cameo -m 0750 /var/lib/cameo/models
ExecStart=/usr/local/bin/cameod
# A crashed daemon takes its supervised endpoints with it (PR_SET_PDEATHSIG), so
# restarting is clean — no orphaned llama-server holding VRAM.
Restart=on-failure
RestartSec=2
# Signal the daemon first so gateway requests drain before child termination.
KillMode=mixed
TimeoutStopSec=75

# The daemon launches model servers and needs the GPU devices, network, and its
# own state directory. Everything else is denied or made read-only.
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
DevicePolicy=closed
DeviceAllow=/dev/kfd rw
DeviceAllow=char-drm rw

[Install]
WantedBy=multi-user.target
