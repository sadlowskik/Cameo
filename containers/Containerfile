# syntax=docker/dockerfile:1
#
# Cameo container image — the portable, hardware-agnostic serving daemon (F1).
#
# One file, two variants:
#   * EDITION=vulkan (default) — the universal base. llama.cpp's Vulkan backend
#     runs on any GPU (AMD/NVIDIA/Intel) that exposes an ICD to the container,
#     and falls back to CPU. This is the "runs anywhere" artifact.
#   * EDITION=rocm — adds the ROCm/HIP accelerator for AMD Tier 1/2 cards.
#
# Build from the repo root:
#   podman build -f containers/Containerfile -t cameo:vulkan .
#   podman build -f containers/Containerfile --build-arg EDITION=rocm -t cameo:rocm .
#
# Run (console reachable + auto-keyed; the entrypoint prints the bearer key):
#   podman run --rm -p 9090:9090 -v cameo-models:/var/lib/cameo/models cameo:vulkan
#
# GPU passthrough at run time is the caller's job and is vendor-specific — for
# AMD: --device /dev/kfd --device /dev/dri (see core/containers for the recipe).
#
# Reproducibility (F4): pass --build-arg SNAPSHOT=YYYY/MM/DD to pin packages to the
# Arch Linux Archive snapshot for that day (the same value as build-iso.sh's
# CAMEO_ARCH_SNAPSHOT, so ISO and container stay in lockstep). Empty (the default)
# tracks rolling Arch. Pinning the `archlinux` base-image *digest* per release is
# the remaining half; do it at publish time.
ARG SNAPSHOT=

# ---- Builder: compile cameo (CLI) + cameod (daemon) on Arch, so the binaries
#      link the same glibc the runtime stage ships. ----
FROM docker.io/library/archlinux:base-devel AS builder
ARG SNAPSHOT
RUN if [ -n "$SNAPSHOT" ]; then \
      printf 'Server=https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' "$SNAPSHOT" \
        > /etc/pacman.d/mirrorlist; \
    fi
RUN pacman -Syu --noconfirm --needed rust
WORKDIR /src
ENV CARGO_HOME=/cargo
# Copy only the workspace — docs, daedalus, node_modules, and ISOs stay out of
# the context (see .dockerignore) so a README edit does not rebuild rustc.
COPY Cargo.toml Cargo.lock rust-toolchain.toml rustfmt.toml ./
COPY cli/ cli/
COPY cameod/ cameod/
COPY core/ core/
RUN --mount=type=cache,target=/cargo/registry \
    --mount=type=cache,target=/cargo/git \
    --mount=type=cache,target=/src/target \
    cargo build --release --bin cameo --bin cameod \
 && install -Dm755 /src/target/release/cameo /out/cameo \
 && install -Dm755 /src/target/release/cameod /out/cameod

# ---- Runtime: the shipped serving image. ----
FROM docker.io/library/archlinux:latest AS runtime
ARG EDITION=vulkan
ARG SNAPSHOT
RUN if [ -n "$SNAPSHOT" ]; then \
      printf 'Server=https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' "$SNAPSHOT" \
        > /etc/pacman.d/mirrorlist; \
    fi
LABEL org.opencontainers.image.title="Cameo" \
      org.opencontainers.image.description="Portable LLM serving daemon — Vulkan-universal, AMD-accelerated." \
      org.opencontainers.image.source="https://github.com/sadlowskik/Cameo"

# Universal Vulkan serving baseline; the ROCm accelerator is layered only for the
# rocm edition. `curl` is what cameo_models shells out to for pulls.
RUN pacman -Syu --noconfirm --needed \
      mesa vulkan-icd-loader vulkan-radeon vulkan-tools \
      llama-cpp ggml-vulkan \
      curl ca-certificates \
 && if [ "$EDITION" = "rocm" ]; then \
      pacman -S --noconfirm --needed rocm-hip-runtime rocminfo ggml-hip; \
    fi \
 && pacman -Scc --noconfirm \
 && rm -rf /var/cache/pacman/pkg/*

COPY --from=builder /out/cameo  /usr/local/bin/cameo
COPY --from=builder /out/cameod /usr/local/bin/cameod
COPY containers/entrypoint.sh /usr/local/bin/cameo-entrypoint
COPY archiso/airootfs/usr/local/bin/cameo-seed-models /usr/local/bin/cameo-seed-models
COPY scripts/fetch-starter-model.sh /tmp/fetch-starter-model.sh
# CI passes CAMEO_SKIP_STARTER=1 so every PR does not download ~380 MiB.
# Release/ISO builds leave it unset and bake qwen2.5-0.5b into the image.
ARG CAMEO_SKIP_STARTER=0
RUN chmod +x /usr/local/bin/cameo-entrypoint /usr/local/bin/cameo-seed-models /tmp/fetch-starter-model.sh \
 && install -d -m 0755 /var/lib/cameo/models /usr/share/cameo/models \
 && CAMEO_SKIP_STARTER="$CAMEO_SKIP_STARTER" \
      /tmp/fetch-starter-model.sh --cache /tmp/cameo-models --dest /usr/share/cameo/models \
 && rm -f /tmp/fetch-starter-model.sh

# Models persist on a mounted volume; the path matches cameo_config and
# cameo_models::models_dir (F2), so `cameo pull` inside the container lands here.
ENV CAMEO_MODELS_DIR=/var/lib/cameo/models
VOLUME /var/lib/cameo/models

# 9090: the control-plane console (auto-keyed by the entrypoint).
# 8080: llama-server's OpenAI-compatible port, once a model is served.
EXPOSE 9090 8080

ENTRYPOINT ["/usr/local/bin/cameo-entrypoint"]
